# Copy to .env and fill in. Never commit .env.

# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...paste the whole .pem here...
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=change-me
BOT_LOGIN=your-app-name[bot]
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Infrastructure (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://prreview:prreview@127.0.0.1:5434/prreview
REDIS_URL=redis://127.0.0.1:6379

# LLM via OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-chat

# Sandbox: without it, reviews are diff-only
E2B_API_KEY=

# Dashboard: repos whose traces are public, and the public base URL for "View full trace" links
DEMO_REPOS=your-user/your-demo-repo
PUBLIC_URL=
